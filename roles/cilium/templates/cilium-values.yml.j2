k8sServiceHost: "{{ k3s_api }}"
k8sServicePort: "{{ k3s_port }}"
k8sClientRateLimit:
  qps: 50
  burst: 100

kubeProxyReplacement: true

l2announcements:
  enabled: true

ingressController:
  enabled: true
  default: false
  loadBalancerMode: "shared"
  service:
    annotations:
      "io.cilium/lb-ipam-ips": "192.168.50.201"

gatewayAPI:
  enabled: true

# Mutual authentication (ceres ADR-0017, 2026-09-18). SPIRE hands every Cilium identity
# a SPIFFE certificate, so a CiliumNetworkPolicy rule can REQUIRE the peer to prove who
# it is (`authentication.mode: required`) before its first packet is let through. It
# changes NO traffic by itself: only a rule that asks for it is affected — today, one:
# the ceres Janus -> Vertumnus mesh port (gitops landingzones/ceres, mesh.enabled).
# SPIRE sits on that one write path and nowhere else; with it down, the ceres console
# cannot dose, and every control loop carries on untouched.
authentication:
  enabled: true
  mutual:
    spire:
      enabled: true
      install:
        enabled: true
        server:
          dataStorage:
            enabled: true
            # Two StorageClasses are marked default (local-path AND longhorn): be explicit,
            # so the SPIRE server's CA survives a node. On a from-scratch rebuild the server
            # waits Pending until Argo has installed Longhorn — nothing but auth-required
            # rules needs it before then.
            storageClass: longhorn

# Transparent encryption between nodes (ceres ADR-0017). Mutual authentication proves
# WHO is connecting; it does not encrypt. WireGuard does, for pod traffic that leaves a
# node (all six run 6.12, which has WireGuard built in; Cilium sizes the MTU for the
# overhead). Same-node traffic never leaves the node and is not encrypted.
encryption:
  enabled: true
  type: wireguard

ipam:
  operator:
    clusterPoolIPv4PodCIDRList:
      - "10.42.0.0/16"

prometheus:
  enabled: true
  serviceMonitor:
    enabled: true
    labels:
      release: kube-prometheus-stack

operator:
  prometheus:
    enabled: true
    serviceMonitor:
      enabled: true
      labels:
        release: kube-prometheus-stack

hubble:
  enabled: true
  relay:
    enabled: true
  ui:
    enabled: true
  metrics:
    enableOpenMetrics: true
    enabled:
      - dns
      - drop
      - tcp
      - flow
      - icmp
      - http
    serviceMonitor:
      enabled: true
      labels:
        release: kube-prometheus-stack